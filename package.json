{
  "name": "@wedevelopnl/silverstripe-admintoolbar",
  "version": "6.0.0",
  "private": true,
  "description": "Frontend admin toolbar for Silverstripe CMS",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:fonts",
    "build:js": "vite build",
    "build:css": "tailwindcss -i client/src/styles/toolbar.css -o client/dist/css/toolbar.css --minify",
    "build:fonts": "mkdir -p client/dist/fonts && cp -R client/fonts/. client/dist/fonts/",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "qa": "npm run lint && npm run format:check && npm run typecheck && npm run coverage && npm run build",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-fail-on-console": "^0.10.1"
  }
}
