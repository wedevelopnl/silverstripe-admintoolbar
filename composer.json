{
    "name": "wedevelopnl/silverstripe-admintoolbar",
    "description": "Frontend admin toolbar for Silverstripe CMS: page actions, CMS menu, user menu and diagnostics",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "admin",
        "toolbar",
        "frontend"
    ],
    "authors": [
        {
            "name": "WeDevelop",
            "email": "development@wedevelop.nl"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "silverstripe/admin": "^3.0",
        "silverstripe/cms": "^6.0",
        "silverstripe/framework": "^6.0",
        "silverstripe/vendor-plugin": "^3.0",
        "silverstripe/versioned": "^3.0"
    },
    "require-dev": {
        "wedevelopnl/silverstripe-e2e": "0.2.0"
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\AdminToolbar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevelop\\AdminToolbar\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
