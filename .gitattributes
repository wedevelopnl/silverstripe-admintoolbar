# Enforce LF line endings
* text=auto eol=lf

# Mark generated build output
/client/dist/**          linguist-generated

# Clean package — exclude dev/build/test files from distribution.
# Only tracked files matter here; gitignored paths (.storyflow/, .superpowers/)
# never reach an archive.

# Dotfiles and dotdirs
/.apm                    export-ignore
/.claude                 export-ignore
/.docker                 export-ignore
/.editorconfig           export-ignore
/.github                 export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.nvmrc                  export-ignore

# Dev and test directories
/client/fonts            export-ignore
/client/src              export-ignore
/docs                    export-ignore
/tests                   export-ignore

# Dev and build config files
/AGENTS.md               export-ignore
/apm.yml                 export-ignore
/biome.json              export-ignore
/CLAUDE.md               export-ignore
/GEMINI.md               export-ignore
/Taskfile.yml            export-ignore
/package.json            export-ignore
/package-lock.json       export-ignore
/stryker.config.mjs      export-ignore
/tsconfig.json           export-ignore
/tsconfig.test.json      export-ignore
/vite.config.mts         export-ignore
/vitest.setup.ts         export-ignore
