# Enforce LF line endings
* text=auto eol=lf

# Mark generated build output
/client/dist/**          linguist-generated

# Clean package — exclude dev/build/test files from distribution.
# Only tracked files matter here; gitignored paths (.storyflow/, .superpowers/)
# never reach an archive.

# Dotfiles and dotdirs
/.apm                    export-ignore
/.claude                 export-ignore
/.docker                 export-ignore
/.editorconfig           export-ignore
/.eslintignore           export-ignore
/.eslintrc.js            export-ignore
/.github                 export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.nvmrc                  export-ignore
/.stylelintignore        export-ignore

# Dev and test directories
/client/src              export-ignore
/docs                    export-ignore
/tests                   export-ignore

# Dev and build config files
/AGENTS.md               export-ignore
/apm.yml                 export-ignore
/CLAUDE.md               export-ignore
/GEMINI.md               export-ignore
/Taskfile.yml            export-ignore
/package.json            export-ignore
/package-lock.json       export-ignore
/postcss.config.js       export-ignore
/stylelint.config.js     export-ignore
/tailwind.config.js      export-ignore
/webpack.config.js       export-ignore
